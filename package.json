{
  "name": "nitroscribe",
  "productName": "NitroScribe",
  "version": "1.0.0",
  "description": "A private, local-first AI meeting notepad: on-device Whisper transcription, speakers by name, and AI notes with the model of your choice.",
  "main": "./out/main/index.js",
  "author": "Eduard Georgescu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eduard-G747/nitroscribe.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "dist:ci": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "sherpa-onnx-node": "2.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
}
